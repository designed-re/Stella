@model object
@{ dynamic m = Model; }
@if (m.Profile is null){<p class="text-zinc-500">Profile not found.</p>}
else{var p=m.Profile;
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-6">
    <div class="flex items-center gap-4 mb-6">
        <div class="h-14 w-14 rounded-lg bg-pink-500/20 text-pink-300 flex items-center justify-center text-xl font-bold">@p.Name.Substring(0, Math.Min(2, p.Name.Length))</div>
        <div><p class="text-xl font-semibold text-zinc-100">@p.Name</p><p class="text-sm text-zinc-500">sv@p.Version · @p.Code · @p.KacId</p></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Packets</p><p class="text-pink-300 font-medium">@p.Packets</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Blocks</p><p class="text-pink-300 font-medium">@p.Blocks</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Skill level</p><p class="text-pink-300 font-medium">@p.SkillLevel</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Appeal ID</p><p class="text-pink-300 font-medium">@p.AppealId</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Scores</p><p class="text-pink-300 font-medium">@m.ScoreCount</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Items</p><p class="text-pink-300 font-medium">@m.ItemCount</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">Rivals</p><p class="text-pink-300 font-medium">@m.RivalCount</p></div>
        <div class="rounded-md bg-zinc-950/60 border border-zinc-800 p-3"><p class="text-xs text-zinc-500">refid</p><p class="text-zinc-300 font-mono text-[10px] truncate">@p.RefId</p></div>
    </div>
</div>}
