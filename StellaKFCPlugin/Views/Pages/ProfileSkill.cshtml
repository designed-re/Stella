@model object
@{ dynamic m = Model; }
<div class="grid grid-cols-2 gap-4 mb-6">
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5"><p class="text-xs text-zinc-500">Skill level</p><p class="text-2xl text-pink-300 font-semibold">@m.SkillLevel</p></div>
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5"><p class="text-xs text-zinc-500">Skill base ID</p><p class="text-2xl text-pink-300 font-semibold">@m.SkillBaseId</p></div>
</div>
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800"><p class="font-medium text-zinc-100">Skill analyzer records</p></div>
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800"><tr><th class="px-5 py-2 font-medium">Type</th><th class="px-5 py-2 font-medium">Base</th><th class="px-5 py-2 font-medium">Level</th><th class="px-5 py-2 font-medium">Name</th></tr></thead>
        <tbody>
        @foreach (var s in m.Skills){<tr class="border-b border-zinc-800/60 last:border-0"><td class="px-5 py-3 text-zinc-400">@s.Type</td><td class="px-5 py-3 text-zinc-400">@s.Base</td><td class="px-5 py-3 text-pink-300">@s.Level</td><td class="px-5 py-3 text-zinc-400">@s.Name</td></tr>}
        @if (m.Skills.Count==0){<tr><td colspan="4" class="px-5 py-8 text-center text-zinc-500">No skill records.</td></tr>}
        </tbody>
    </table>
</div>
