@model object
@{ dynamic m = Model; }
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800"><p class="font-medium text-zinc-100">Items <span class="text-zinc-500 text-sm">(@m.Items.Count)</span></p></div>
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800"><tr><th class="px-5 py-2 font-medium">Type</th><th class="px-5 py-2 font-medium">Item ID</th><th class="px-5 py-2 font-medium">Param</th></tr></thead>
        <tbody>
        @foreach (var i in m.Items){<tr class="border-b border-zinc-800/60 last:border-0"><td class="px-5 py-3 text-zinc-400">@i.Type</td><td class="px-5 py-3 text-pink-300 font-mono text-xs">@i.ItemId</td><td class="px-5 py-3 text-zinc-400">@i.Param</td></tr>}
        @if (m.Items.Count==0){<tr><td colspan="3" class="px-5 py-8 text-center text-zinc-500">No unlocked items.</td></tr>}
        </tbody>
    </table>
</div>
