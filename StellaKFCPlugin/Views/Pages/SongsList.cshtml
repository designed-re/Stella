@model object
@{ dynamic m = Model; }
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
        <p class="font-medium text-zinc-100">Songs <span class="text-zinc-500 text-sm">(@m.Songs.Count shown)</span></p>
        <form method="get" action="/webui/p/StellaKFCPlugin/songs-list" class="flex items-center gap-2">
            <input type="hidden" name="v" value="1" />
            <span class="text-xs text-zinc-500">sv@m.Version</span>
        </form>
    </div>
    <div class="overflow-x-auto max-h-[70vh]">
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800 sticky top-0 bg-zinc-900"><tr><th class="px-5 py-2 font-medium">ID</th><th class="px-5 py-2 font-medium">Title</th><th class="px-5 py-2 font-medium">Artist</th><th class="px-5 py-2 font-medium">Version</th><th class="px-5 py-2 font-medium">Release</th></tr></thead>
        <tbody>
        @foreach (var s in m.Songs){<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-800/30"><td class="px-5 py-3 text-zinc-400 font-mono">@s.Id</td><td class="px-5 py-3 text-zinc-100">@s.Title</td><td class="px-5 py-3 text-zinc-400">@s.Artist</td><td class="px-5 py-3 text-zinc-400">sv@s.Version</td><td class="px-5 py-3 text-zinc-400">@s.Date</td></tr>}
        @if (m.Songs.Count==0){<tr><td colspan="5" class="px-5 py-8 text-center text-zinc-500">No songs for this version. Load music_db.xml from the Data page.</td></tr>}
        </tbody>
    </table>
    </div>
</div>
