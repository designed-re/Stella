@model object
@{ dynamic m = Model; }
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5"><p class="text-xs uppercase tracking-wider text-zinc-500">Static event rows</p><p class="mt-1 text-2xl font-semibold text-pink-300">@m.StaticEventCount</p></div>
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5"><p class="text-xs uppercase tracking-wider text-zinc-500">sv_music rows</p><p class="mt-1 text-2xl font-semibold text-pink-300">@m.MusicCount</p></div>
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5"><p class="text-xs uppercase tracking-wider text-zinc-500">music_db.xml on disk</p><p class="mt-1 text-2xl font-semibold @(m.MusicDbPresent ? "text-emerald-400" : "text-zinc-500")">@(m.MusicDbPresent ? "present" : "missing")</p></div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5">
        <p class="font-medium text-zinc-100 mb-3">Static data (sv_static_*)</p>
        <p class="text-sm text-zinc-400 mb-4">Seeds events, courses, valgene, arena, extend, music limits from <code class="text-pink-300">Data/Seed/asphyxia_data.json</code>. Idempotent.</p>
        <button id="seed-static" class="px-4 py-2 rounded-md bg-pink-500 hover:bg-pink-400 text-zinc-950 font-medium">Seed static data</button>
        <p id="seed-static-msg" class="mt-3 text-sm text-zinc-400"></p>
    </div>
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-5">
        <p class="font-medium text-zinc-100 mb-3">music_db.xml</p>
        <p class="text-sm text-zinc-400 mb-4">Upload <code class="text-pink-300">music_db.xml</code> (shift_jis) to load difficulty levels into <code class="text-pink-300">sv_music</code>.</p>
        <input id="mdb-file" type="file" accept=".xml,text/xml" class="block w-full text-sm text-zinc-400 file:mr-3 file:px-3 file:py-1.5 file:rounded-md file:border-0 file:bg-zinc-800 file:text-zinc-200 mb-3" />
        <button id="upload-mdb" class="px-4 py-2 rounded-md bg-pink-500 hover:bg-pink-400 text-zinc-950 font-medium">Upload &amp; load</button>
        <button id="reload-mdb" class="ml-2 px-4 py-2 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium">Reload from disk</button>
        <p id="mdb-msg" class="mt-3 text-sm text-zinc-400"></p>
    </div>
</div>
@Html.AntiForgeryToken()
<script>
const P="StellaKFCPlugin";
document.getElementById("seed-static").addEventListener("click",async()=>{const m=document.getElementById("seed-static-msg");m.textContent="seeding…";const r=await Stella.emit(P,"seedStatic",{});m.textContent=r?.ok?"✓ "+r.message:"✗ "+r?.message;if(r?.ok)setTimeout(()=>location.reload(),800);});
document.getElementById("reload-mdb").addEventListener("click",async()=>{const m=document.getElementById("mdb-msg");m.textContent="loading…";const r=await Stella.emit(P,"loadMusicDb",{});m.textContent=r?.ok?"✓ "+r.message:"✗ "+r?.message;if(r?.ok)setTimeout(()=>location.reload(),800);});
document.getElementById("upload-mdb").addEventListener("click",async()=>{const f=document.getElementById("mdb-file").files[0];if(!f){document.getElementById("mdb-msg").textContent="choose a file first";return;}const b64=await new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result.split(",")[1]);fr.readAsDataURL(f);});const m=document.getElementById("mdb-msg");m.textContent="uploading…";const r=await Stella.emit(P,"uploadMusicDb",{base64:b64});m.textContent=r?.ok?"✓ "+r.message:"✗ "+r?.message;if(r?.ok)setTimeout(()=>location.reload(),800);});
</script>
