@model object
@{ dynamic m = Model; }
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800"><p class="font-medium text-zinc-100">Rivals <span class="text-zinc-500 text-sm">(@m.Rivals.Count)</span></p></div>
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800"><tr><th class="px-5 py-2 font-medium">Name</th><th class="px-5 py-2 font-medium">SDVX ID</th><th class="px-5 py-2 font-medium">Mutual</th><th class="px-5 py-2 font-medium">Ver</th></tr></thead>
        <tbody>
        @foreach (var r in m.Rivals){<tr class="border-b border-zinc-800/60 last:border-0"><td class="px-5 py-3 text-zinc-100">@r.Name</td><td class="px-5 py-3 text-zinc-400 font-mono">@r.SdvxId</td><td class="px-5 py-3">@(r.Mutual ? "✓" : "—")</td><td class="px-5 py-3 text-zinc-400">sv@r.Version</td></tr>}
        @if (m.Rivals.Count==0){<tr><td colspan="4" class="px-5 py-8 text-center text-zinc-500">No rivals added.</td></tr>}
        </tbody>
    </table>
</div>
