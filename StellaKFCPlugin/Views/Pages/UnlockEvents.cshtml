@model object
@{ dynamic m = Model; }
@Html.AntiForgeryToken()
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800"><p class="font-medium text-zinc-100">Unlock events <span class="text-zinc-500 text-sm">(@m.Events.Count)</span></p><p class="text-zinc-500 text-xs mt-1">Toggle in-game events (stamps, tama, variant gate, achievement missions). Disabled by default — enable the ones you want active.</p></div>
    <div class="overflow-x-auto max-h-[70vh]">
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800 sticky top-0 bg-zinc-900"><tr><th class="px-5 py-2 font-medium">Ver</th><th class="px-5 py-2 font-medium">Event ID</th><th class="px-5 py-2 font-medium">Type</th><th class="px-5 py-2 font-medium">Start</th><th class="px-5 py-2 font-medium">Name</th><th class="px-5 py-2 font-medium">Enabled</th><th class="px-5 py-2 font-medium"></th></tr></thead>
        <tbody>
        @foreach (var e in m.Events){<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-800/30"><td class="px-5 py-3 text-zinc-400">sv@e.Version</td><td class="px-5 py-3 text-zinc-100 font-mono text-xs">@e.EventId</td><td class="px-5 py-3 text-pink-300/80 font-mono text-xs">@e.Type</td><td class="px-5 py-3 text-zinc-400 font-mono text-xs">@e.StartDate</td><td class="px-5 py-3 text-zinc-300">@e.Name</td><td class="px-5 py-3"><span class="px-2 py-0.5 rounded text-xs @(e.Enabled ? "bg-pink-500/20 text-pink-300" : "bg-zinc-800 text-zinc-500")">@(e.Enabled ? "on" : "off")</span></td><td class="px-5 py-3 text-right"><button class="text-pink-400 hover:text-pink-300" onclick="toggleEvent(@e.Version,'@e.EventId',this)">toggle</button></td></tr>}
        @if (m.Events.Count==0){<tr><td colspan="7" class="px-5 py-8 text-center text-zinc-500">No events seeded. Seed static data from the Data page.</td></tr>}
        </tbody>
    </table>
    </div>
</div>
<script>
async function toggleEvent(v,id,btn){const r=await Stella.emit("StellaKFCPlugin","toggleUnlockEvent",{version:v,event_id:id});if(r?.ok){const tr=btn.closest("tr");const cell=tr.querySelector("td:nth-child(6) span");cell.textContent=r.enabled?"on":"off";cell.className="px-2 py-0.5 rounded text-xs "+(r.enabled?"bg-pink-500/20 text-pink-300":"bg-zinc-800 text-zinc-500");}}
</script>
