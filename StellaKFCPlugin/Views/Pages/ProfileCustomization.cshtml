@model object
@{ dynamic m = Model; }
@Html.AntiForgeryToken()
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-6">
        <p class="font-medium text-zinc-100 mb-4">Edit profile</p>
        <form id="profile-form" class="space-y-4">
            <div><label class="block text-sm text-zinc-400 mb-1.5">Name (max 8, A–Z0–9!?$&#38;*-. )</label><input name="name" value="@m.Name" maxlength="8" class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-100 uppercase" /></div>
            <div><label class="block text-sm text-zinc-400 mb-1.5">Appeal card ID</label><input name="appeal_id" type="number" value="@m.AppealId" class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-100" /></div>
            <input type="hidden" name="refid" value="@m.RefId" /><input type="hidden" name="version" value="@m.Version" />
            <button class="px-4 py-2 rounded-md bg-pink-500 hover:bg-pink-400 text-zinc-950 font-medium">Save</button>
            <p id="cust-msg" class="text-sm text-zinc-400"></p>
        </form>
    </div>
    <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
        <div class="px-5 py-4 border-b border-zinc-800"><p class="font-medium text-zinc-100">Param records</p></div>
        <div class="overflow-x-auto max-h-[60vh]">
        <table class="w-full text-sm">
            <thead class="text-left text-zinc-500 border-b border-zinc-800"><tr><th class="px-5 py-2 font-medium">Type</th><th class="px-5 py-2 font-medium">ID</th><th class="px-5 py-2 font-medium">Count</th><th class="px-5 py-2 font-medium">Values</th></tr></thead>
            <tbody>
            @foreach (var p in m.Params){<tr class="border-b border-zinc-800/60 last:border-0"><td class="px-5 py-3 text-zinc-400">@p.Type</td><td class="px-5 py-3 text-pink-300">@p.ParamId</td><td class="px-5 py-3 text-zinc-400">@p.ParamCount</td><td class="px-5 py-3 text-zinc-500 font-mono text-[10px] truncate max-w-xs">@p.Param</td></tr>}
            @if (m.Params.Count==0){<tr><td colspan="4" class="px-5 py-8 text-center text-zinc-500">No param records.</td></tr>}
            </tbody>
        </table>
        </div>
    </div>
</div>
<script>
document.getElementById("profile-form").addEventListener("submit",async(e)=>{e.preventDefault();const f=e.target;const p={refid:f.refid.value,version:parseInt(f.version.value),name:f.name.value,appeal_id:parseInt(f.appeal_id.value||"0")};const m=document.getElementById("cust-msg");m.textContent="saving…";const r=await Stella.emit("StellaKFCPlugin","updateProfile",p);m.textContent=r?.ok?"✓ saved":"✗ "+(r?.message??"error");});
</script>
