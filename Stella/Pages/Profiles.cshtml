@page "/webui/profiles"
@model Stella.WebUI.Pages.ProfilesModel
@{
    ViewData["Title"] = "Profiles";
}
<div class="rounded-xl bg-zinc-900/60 border border-zinc-800 overflow-hidden">
    <div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
        <p class="font-medium text-zinc-100">Profiles</p>
        <span class="text-xs text-zinc-500">@Model.Rows.Count total</span>
    </div>
    <table class="w-full text-sm">
        <thead class="text-left text-zinc-500 border-b border-zinc-800">
            <tr>
                <th class="px-5 py-2 font-medium">Name</th>
                <th class="px-5 py-2 font-medium">Code</th>
                <th class="px-5 py-2 font-medium">Plugin</th>
                <th class="px-5 py-2 font-medium">Version</th>
                <th class="px-5 py-2 font-medium">Card</th>
                <th class="px-5 py-2 font-medium">PASERI</th>
                <th class="px-5 py-2 font-medium"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-800/30">
                <td class="px-5 py-3 text-zinc-100">@r.Name</td>
                <td class="px-5 py-3 text-zinc-400">@r.Code</td>
                <td class="px-5 py-3 text-zinc-400">@r.PluginId</td>
                <td class="px-5 py-3 text-zinc-400">sv@r.Version</td>
                <td class="px-5 py-3 text-zinc-400 font-mono text-xs">@r.CardId</td>
                <td class="px-5 py-3 text-zinc-400">@r.Paseli</td>
                <td class="px-5 py-3 text-right">
                    <a href="/webui/profile/@r.RefId" class="text-pink-400 hover:text-pink-300">view</a>
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="7" class="px-5 py-8 text-center text-zinc-500">No profiles yet. A profile is created when a player first cards in.</td></tr>
        }
        </tbody>
    </table>
</div>
