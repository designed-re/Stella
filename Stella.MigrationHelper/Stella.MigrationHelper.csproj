<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StellaKFCPlugin\StellaKFCPlugin.csproj" />
  </ItemGroup>

 <!--
   Design-time host for `dotnet ef`. It must NOT ship a plugins/ folder of its
   own: a source plugins/ folder here gets globbed by the Web SDK as content
   and copied into the output, and the copy then gets re-globbed on the next
   build, producing bin/Debug/net10.0/bin/Debug/... infinite nesting.
   - Remove any plugins/ glob so a stray folder can't seed recursion.
    - Explicitly strip bin/** and obj/** from the Web SDK content/none globs so
      the output directory is never re-globbed as content (the Web SDK excludes
      these by default, but transitive ProjectReference content with
      CopyToOutputDirectory can still seed bin/Debug/net10.0/bin/Debug/...
      nesting; the explicit removes are belt-and-braces).
    - dotnet ef uses StellaKFCContextFactory (hardcoded connection string), so
      no plugin_kfc.json is needed in this host's output.
 -->
 <ItemGroup>
   <Content Remove="plugins/**" />
   <None Remove="plugins/**" />
    <Content Remove="bin/**" />
    <None Remove="bin/**" />
    <Content Remove="obj/**" />
    <None Remove="obj/**" />
 </ItemGroup>

</Project>
